{
  "name": "drop-worker",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "tsx server/local.ts",
    "start:cloudflare": "vinext start",
    "test": "npm run typecheck && npm run test:unit && npm run build && npm run test:render",
    "test:unit": "node --import tsx --test tests/admin.test.ts tests/api.test.ts tests/auth.test.ts tests/client-address.test.ts tests/migration.test.ts tests/r2-direct-uploads.test.ts tests/runtime-config.test.ts tests/schema-comments.test.ts tests/storage-config.test.ts tests/storage-migration.test.ts tests/worker-relational.test.ts tests/render-wrangler-config.test.mjs",
    "test:render": "node --test tests/rendered-html.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate --config drizzle/config/sqlite.ts",
    "db:generate:postgres": "drizzle-kit generate --config drizzle/config/postgres.ts",
    "db:generate:mysql": "drizzle-kit generate --config drizzle/config/mysql.ts",
    "admin": "tsx server/admin.ts",
    "cf:types": "wrangler types worker/types/worker-configuration.d.ts --strict-vars=false --config wrangler.example.jsonc",
    "cf:types:check": "wrangler types worker/types/worker-configuration.d.ts --strict-vars=false --config wrangler.example.jsonc --check",
    "cf:deploy": "npm run build && wrangler deploy --config wrangler.jsonc",
    "cf:dry-run": "npm run build && wrangler deploy --dry-run --config wrangler.jsonc"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1107.0",
    "@hono/node-server": "^2.1.0",
    "aws4fetch": "^1.0.20",
    "dotenv": "^17.4.2",
    "drizzle-orm": "0.45.2",
    "hono": "^4.13.0",
    "lucide-react": "^1.28.0",
    "mysql2": "^3.23.3",
    "nodemailer": "^9.0.4",
    "pg": "^8.23.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tsx": "^4.23.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.21.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "^4.118.0"
  },
  "type": "module"
}
