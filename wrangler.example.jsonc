{
  // Wrangler 配置 JSON Schema：为编辑器提供字段补全和校验。
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Worker 在 Cloudflare 中的名称，也是默认部署目标名称。
  "name": "drop-worker",
  // 构建产物中的 Worker 入口文件；npm run build 会生成它。
  "main": "dist/server/index.js",
  // 固定 Workers 运行时兼容行为；升级运行时前请先验证并更新日期。
  "compatibility_date": "2026-08-11",
  // 启用 Node.js 兼容层，供 Worker 中使用 Node 风格 API 的依赖运行。
  "compatibility_flags": ["nodejs_compat"],
  // 将前端静态资源与 Worker 一起发布。
  "assets": {
    // Vite/Vinext 构建出的浏览器端静态文件目录。
    "directory": "./dist/client",
    // Worker 中通过 env.ASSETS 访问静态资源绑定。
    "binding": "ASSETS",
    // 找不到静态文件时返回 SPA 入口，交给前端路由处理。
    "not_found_handling": "single-page-application"
  },
  // D1 SQLite 数据库绑定。
  "d1_databases": [
    {
      // Worker 代码通过 env.DB 使用这个数据库。
      "binding": "DB",
      // Cloudflare 控制台中的数据库名称。
      "database_name": "drop-worker",
      // 目标 D1 数据库 UUID；部署前替换为自己的 ID。
      "database_id": "<D1_DATABASE_ID>",
      // Drizzle/D1 迁移文件目录。
      "migrations_dir": "./drizzle/sqlite"
    }
  ],
  // R2 对象存储桶绑定，用于保存上传文件。
  "r2_buckets": [
    {
      // Worker 代码通过 env.FILES 使用这个桶。
      "binding": "FILES",
      // Cloudflare R2 控制台中的桶名称。
      "bucket_name": "drop-worker-files"
    }
  ],
  // Cloudflare Email Service 发信绑定；改用自定义 SMTP 时可以删除整个 send_email 数组。
  "send_email": [
    {
      // Worker 代码通过 env.EMAIL 发送邮件。
      "name": "EMAIL",
      // 固定允许投递到的收件地址；这里填写自己的邮箱。
      "destination_address": "you@example.com",
      // 本地 Wrangler 开发也使用远程 Email Service 绑定。
      "remote": true
    }
  ],
  // 非机密运行时变量。会以明文进入 Worker 配置，不要放密码或 Token。
  "vars": {
    // 认证模式；smtp-otp 表示使用邮箱一次性验证码登录。
    "AUTH_MODE": "smtp-otp",
    // 验证码邮件提供方：cloudflare 使用 Email Service，smtp 使用自定义 SMTP。
    "AUTH_EMAIL_PROVIDER": "smtp",
    // 单实例最大存储空间，单位为字节。
    "MAX_STORAGE_BYTES": "10737418240",
    // 生成公开分享链接时使用的可信地址，不能从请求 Host 动态推断。
    "PUBLIC_URL": "https://drop.example.com",
    // 紧急情况下可设为 false，立即暂停创建和访问全部分享。
    "SHARING_ENABLED": "true",
    // R2 S3 API 端点所属账号；用于为浏览器生成短期直传地址。
    "R2_ACCOUNT_ID": "<CLOUDFLARE_ACCOUNT_ID>",
    // 必须与上面的 FILES 绑定指向同一个桶。
    "R2_BUCKET_NAME": "drop-worker-files",
    // 可选的公开 R2 自定义域名；配置后下载会在权限校验后重定向到该地址。
    "R2_PUBLIC_URL": "https://drop-files.example.com",
    // 唯一允许登录的个人邮箱，也用于接收验证码。
    "OWNER_EMAIL": "you@example.com",
    // 验证码邮件的发件地址；使用 Cloudflare Email Service 时必须是已验证域名地址。
    "AUTH_FROM_EMAIL": "noreply@example.com",
    // 验证码邮件显示的发件人名称。
    "AUTH_FROM_NAME": "Drop Worker",
    // 自定义 SMTP 服务器地址；AUTH_EMAIL_PROVIDER 为 smtp 时必填。
    "SMTP_HOST": "smtp.163.com",
    // SMTP 端口，支持 465/994（隐式 TLS）或 587（STARTTLS）。
    "SMTP_PORT": "994",
    // 是否使用隐式 TLS；465/994 通常设为 true，587 通常设为 false 并使用 STARTTLS。
    "SMTP_SECURE": "false",
    // 自定义 SMTP 的实际发件地址；留空时回退到 AUTH_FROM_EMAIL。
    "SMTP_FROM": "",
    // SMTP 连接超时时间，单位为毫秒。
    "SMTP_TIMEOUT_MS": "15000",
    // 使用 Cloudflare Access JWT 身份时填写团队域名；邮箱验证码模式可留空。
    "CF_ACCESS_TEAM_DOMAIN": "",
    // 使用 Cloudflare Access JWT 身份时填写 Access 应用 Audience；邮箱验证码模式可留空。
    "CF_ACCESS_AUD": ""
  },
  // 定时任务配置；17 * * * * 表示每小时执行一次计划清理任务。
  "triggers": {
    "crons": ["17 * * * *"]
  },
  // Cloudflare Worker 可观测性配置。
  "observability": {
    // 开启日志和追踪。
    "enabled": true,
    "logs": {
      // 记录 100% 的请求日志采样；应用自身不会记录正文、验证码或密码。
      "head_sampling_rate": 1
    },
    "traces": {
      // 开启请求追踪。
      "enabled": true,
      // 只采样 1% 的追踪，降低生产开销。
      "head_sampling_rate": 0.01
    }
  }
}
