PORT=3000
HOST=0.0.0.0
PUBLIC_URL=http://localhost:3000
DATA_DIR=./data
MAX_STORAGE_BYTES=10737418240
SHARING_ENABLED=true
TRUST_PROXY=

# sqlite、mysql 或 postgres；外部数据库需先运行 npm run admin -- migrate-database
DATABASE_DRIVER=sqlite
DATABASE_URL=
DATABASE_POOL_SIZE=10
DATABASE_CA_FILE=
DATABASE_ALLOW_INSECURE=false

# local 或 s3
BLOB_DRIVER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_PREFIX=drop-worker/
S3_FORCE_PATH_STYLE=false
S3_ALLOW_INSECURE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
# 留空、AES256 或 aws:kms
S3_SERVER_SIDE_ENCRYPTION=
S3_KMS_KEY_ID=

# password 或 smtp-otp
AUTH_MODE=password
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=
SESSION_SECRET=replace-with-at-least-32-random-characters

# 非 localhost 的 HTTP 部署必须显式开启；请勿在公网使用。
ALLOW_INSECURE_HTTP=false

# AUTH_MODE=smtp-otp 时填写
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=drop-worker@example.com
