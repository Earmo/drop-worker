PORT=3000
HOST=0.0.0.0
PUBLIC_URL=http://localhost:3000
DATA_DIR=./data
MAX_STORAGE_BYTES=10737418240

# password 或 smtp-otp
AUTH_MODE=password
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=
SESSION_SECRET=replace-with-at-least-32-random-characters

# 非 localhost 的 HTTP 部署必须显式开启；请勿在公网使用。
ALLOW_INSECURE_HTTP=false

# AUTH_MODE=smtp-otp 时填写
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=drop-worker@example.com
