[Unit]
Description=drop-worker 私有投递箱
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/drop-worker
EnvironmentFile=/opt/drop-worker/.env
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=5
User=drop-worker
Group=drop-worker
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
